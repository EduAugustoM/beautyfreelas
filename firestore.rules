rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Professionals: public read, self-write only
    match /professionals/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Services: public read (needed for booking page)
    // create: only the authenticated professional can add services to their own account
    // update/delete: only the professional who owns the service
    match /services/{serviceId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.professionalId == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'price', 'durationMinutes', 'professionalId'])
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.durationMinutes is number
        && request.resource.data.durationMinutes > 0;
      allow update, delete: if request.auth != null
        && resource.data.professionalId == request.auth.uid;
    }

    // Appointments:
    // read: only the owning professional (LGPD compliance — client PII is protected)
    // create: public (guest clients book without an account), but fields are validated
    // update: only the owning professional, and only the 'status' field
    // delete: not allowed
    match /appointments/{appointmentId} {
      allow read: if request.auth != null
        && resource.data.professionalId == request.auth.uid;
      allow create: if
        request.resource.data.keys().hasAll([
          'professionalId', 'serviceId', 'date',
          'startTime', 'endTime', 'guestClient', 'status'
        ])
        && request.resource.data.status == 'CONFIRMED'
        && request.resource.data.guestClient.keys().hasAll(['name', 'phone'])
        && request.resource.data.guestClient.name is string
        && request.resource.data.guestClient.name.size() >= 2
        && request.resource.data.guestClient.phone is string
        && request.resource.data.guestClient.phone.size() >= 8;
      allow update: if request.auth != null
        && resource.data.professionalId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }
  }
}